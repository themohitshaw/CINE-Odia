# ==========================================================
# CINE-Odia - Git Ignore
# ==========================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------
# Virtual Environment
# -------------------------
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Flask
# -------------------------
instance/
.webassets-cache/

# -------------------------
# Database
# -------------------------
*.db
*.sqlite
*.sqlite3

# PostgreSQL local files
*.dump
*.sql.bak

# -------------------------
# IDE / Editors
# -------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

# -------------------------
# Jupyter Notebook
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# OS Generated Files
# -------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~

# -------------------------
# Build / Distribution
# -------------------------
build/
dist/
*.egg-info/
.eggs/

# -------------------------
# Coverage
# -------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo

# -------------------------
# Uploaded Files
# -------------------------
uploads/*
!uploads/.gitkeep

# -------------------------
# Secret / Credential Files
# -------------------------
*.pem
*.key
credentials.json
secrets.json

# -------------------------
# Node.js (if used later)
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# Deployment
# -------------------------
.vercel/
.netlify/